# Server Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Database
DB_PATH=./data/tunnels.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Tunnel Configuration
MAX_TUNNELS_PER_USER=5
TUNNEL_SUBDOMAIN_PREFIX=

# Localtunnel Server
# Leave empty to use public localtunnel.me (may have password protection)
# Set to use self-hosted server: LOCALTUNNEL_HOST=https://your-server.com
# For local testing: LOCALTUNNEL_HOST=http://localhost:8080
# See SELF_HOSTED_SERVER.md for setup instructions
LOCALTUNNEL_HOST=
